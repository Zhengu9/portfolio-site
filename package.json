{
  "name": "zhengu9-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:admin": "node scripts/setup-local-admin.mjs",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db --local --persist-to .wrangler/state",
    "dev": "npm run build && npm run db:migrate:local && wrangler pages dev --persist-to .wrangler/state",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
